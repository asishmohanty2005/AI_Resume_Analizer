# Use backend/.env instead of this root file; see backend/.env.example.
# The backend publishes these public values at /api/public-config.js.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# The static frontend does not read .env automatically.
# SUPABASE_SERVICE_ROLE_KEY is not used by this app and must never be exposed
# in frontend configuration. Only add it to a backend environment if a future
# server-side integration requires privileged access.
